# Copy this to ".env" (same folder as docker-compose.yml) and fill in.

# A long random string (used to sign login sessions). Generate one, keep it secret.
SESSION_SECRET=replace-with-a-long-random-string

# Password for the first-run "admin" account. Leave blank to have a strong
# random one generated and printed to the console once on first launch.
ADMIN_PASSWORD=

# ngrok (free) — for the fixed public URL. Leave blank to run LAN-only.
NGROK_AUTHTOKEN=
# Your claimed free static domain, e.g. gaanasudha-music.ngrok-free.app
NGROK_DOMAIN=
